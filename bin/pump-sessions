#!/bin/bash
# pump-sessions — Track coding productivity across repos by session.
#
# Groups git commits + manual notes into sessions based on time gaps.
# A new session starts after 60+ minutes of inactivity.
#
# Usage:
#   pump-sessions [options] [lookback]
#
# Options:
#   --html [file]     Generate HTML report (default: ~/Desktop/sessions-report.html)
#   --note "text"     Log a session note (creates activity even without commits)
#   --log "text"      Alias for --note
#
# Lookback:
#   24                Last 24 hours (default)
#   48                Last 48 hours
#   7d                Last 7 days

set -euo pipefail

# === Configuration ===
GAP_SECONDS=3600
LOG_FILE="$HOME/.claude/session-log.jsonl"
REPOS=(
  "$HOME/dev/claude_test/my_mind_evolved:second-brain"
  "$HOME/dev/claude_test/nanny_management/nanny-app:nanny-app"
  "$HOME/dev/claude_test/vocab_app/lexica:lexica"
  "$HOME/dev/claude_test/command-center:command-center"
  "$HOME/dev/claude_test:claude-test"
)

# === Argument parsing ===
OUTPUT_FORMAT="text"
HTML_FILE="$HOME/Desktop/sessions-report.html"
NOTE_TEXT=""
MODE="report"
LOOKBACK=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --html)
      OUTPUT_FORMAT="html"
      if [[ "${2:-}" != "" && "${2:-}" != --* && ! "${2:-}" =~ ^[0-9] ]]; then
        HTML_FILE="$2"; shift
      fi
      shift ;;
    --note|--log)
      MODE="note"; NOTE_TEXT="${2:-}"; shift 2 ;;
    *) LOOKBACK="$1"; shift ;;
  esac
done

LOOKBACK="${LOOKBACK:-24}"
case "$LOOKBACK" in
  *d) HOURS=$(( ${LOOKBACK%d} * 24 )) ;;
  *h) HOURS="${LOOKBACK%h}" ;;
  *)  HOURS="$LOOKBACK" ;;
esac
SINCE="$HOURS hours ago"
SINCE_TS=$(date -v-${HOURS}H +%s 2>/dev/null || date -d "$SINCE" +%s)

# === Note logging mode ===
if [ "$MODE" = "note" ]; then
  if [ -z "$NOTE_TEXT" ]; then
    echo "Usage: pump-sessions --note \"your note here\""
    exit 1
  fi
  TS=$(date +%s)
  TIME_FMT=$(date -r "$TS" "+%-l:%M %p" 2>/dev/null || date -d "@$TS" "+%-l:%M %p")
  mkdir -p "$(dirname "$LOG_FILE")"
  python3 -c "
import json, sys
entry = {'ts': $TS, 'text': sys.argv[1]}
print(json.dumps(entry))
" "$NOTE_TEXT" >> "$LOG_FILE"
  echo "  Logged: \"${NOTE_TEXT}\" (${TIME_FMT})"
  exit 0
fi

# === Temp files ===
TMPDIR_WORK=$(mktemp -d)
trap "rm -rf $TMPDIR_WORK" EXIT
ALL_ENTRIES="$TMPDIR_WORK/entries"
touch "$ALL_ENTRIES"

# Helper: JSON-escape a string (outputs quoted string)
json_str() {
  python3 -c "import sys,json; sys.stdout.write(json.dumps(sys.stdin.read()))" <<< "$1"
}

# === Step 1: Collect git commits ===
for entry in "${REPOS[@]}"; do
  repo_path="${entry%%:*}"
  repo_name="${entry##*:}"
  [ -d "$repo_path/.git" ] || continue
  # Format: timestamp|type|repo_name|hash|subject
  git -C "$repo_path" log --all --branches \
    --format="%at|commit|${repo_name}|%H|%s" \
    --since="$SINCE" 2>/dev/null >> "$ALL_ENTRIES" || true
done

# === Step 2: Collect manual notes ===
if [ -f "$LOG_FILE" ]; then
  python3 -c "
import json, sys
since_ts = int(sys.argv[1])
for line in open(sys.argv[2]):
    line = line.strip()
    if not line: continue
    try:
        entry = json.loads(line)
        ts = entry['ts']
        if ts >= since_ts:
            text = entry['text'].replace('|', '-')
            print(f'{ts}|note|__note__|n{ts}|{text}')
    except: pass
" "$SINCE_TS" "$LOG_FILE" >> "$ALL_ENTRIES" 2>/dev/null || true
fi

# === Step 3: Collect GitHub PR activity ===
collect_github_activity() {
  for entry in "${REPOS[@]}"; do
    repo_path="${entry%%:*}"
    repo_name="${entry##*:}"
    [ -d "$repo_path/.git" ] || continue

    # Get GitHub remote owner/repo
    REMOTE_URL=$(git -C "$repo_path" remote get-url origin 2>/dev/null || true)
    [ -z "$REMOTE_URL" ] && continue
    # Extract owner/repo from URL
    GH_REPO=$(echo "$REMOTE_URL" | sed -E 's|.*github\.com[:/]([^/]+/[^/.]+)(\.git)?$|\1|')
    [ -z "$GH_REPO" ] && continue

    # Get PR events (created, merged, reviewed)
    gh api "repos/${GH_REPO}/issues/comments" \
      --paginate -q ".[] | select(.created_at > \"$(date -v-${HOURS}H -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d \"$SINCE\" +%Y-%m-%dT%H:%M:%SZ)\") | .created_at + \"|comment|${repo_name}|pr-\" + (.issue_url | split(\"/\") | last) + \"|PR #\" + (.issue_url | split(\"/\") | last) + \": \" + (.body | split(\"\\n\") | first | .[:80])" \
      2>/dev/null | while IFS='|' read -r created_at type repo hash subject; do
      # Convert ISO date to epoch
      TS=$(date -jf "%Y-%m-%dT%H:%M:%SZ" "$created_at" +%s 2>/dev/null || date -d "$created_at" +%s 2>/dev/null || true)
      [ -z "$TS" ] && continue
      echo "${TS}|comment|${repo}|${hash}|${subject}" >> "$ALL_ENTRIES"
    done || true

    # Get PRs created/merged in timeframe
    gh pr list --repo "$GH_REPO" --state all --json number,title,createdAt,mergedAt \
      --limit 50 2>/dev/null | python3 -c "
import json, sys, subprocess
from datetime import datetime, timezone, timedelta
since_ts = int(sys.argv[1])
repo_name = sys.argv[2]
data = json.load(sys.stdin)
for pr in data:
    for event_type, date_field, prefix in [('pr', 'createdAt', 'opened'), ('pr-merge', 'mergedAt', 'merged')]:
        dt_str = pr.get(date_field, '')
        if not dt_str: continue
        dt = datetime.fromisoformat(dt_str.replace('Z', '+00:00'))
        ts = int(dt.timestamp())
        if ts >= since_ts:
            title = pr['title'].replace('|', '-')[:80]
            print(f'{ts}|{event_type}|{repo_name}|pr-{pr[\"number\"]}|{prefix} PR #{pr[\"number\"]}: {title}')
" "$SINCE_TS" "$repo_name" >> "$ALL_ENTRIES" 2>/dev/null || true
  done
}

# Only collect GitHub data if gh is available and authenticated
if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
  collect_github_activity
fi

# === Step 4: Sort and group into sessions ===
sort -t'|' -k1 -n "$ALL_ENTRIES" -o "$ALL_ENTRIES"

if [ ! -s "$ALL_ENTRIES" ]; then
  if [ "$OUTPUT_FORMAT" = "text" ]; then
    echo ""
    echo "  No activity found in the last ${HOURS}h."
    echo "  Log a note: pump-sessions --note \"what you're working on\""
    echo ""
  fi
  exit 0
fi

SESSIONS_FILE="$TMPDIR_WORK/sessions"
awk -F'|' -v gap="$GAP_SECONDS" '
BEGIN { session = 1; prev_ts = 0 }
{
  ts = $1
  if (prev_ts > 0 && (ts - prev_ts) > gap) session++
  print session "|" $0
  prev_ts = ts
}
' "$ALL_ENTRIES" > "$SESSIONS_FILE"

# === Step 5: Enrich with diff stats (commits only) ===
ENRICHED="$TMPDIR_WORK/enriched"
touch "$ENRICHED"
SESSION_NUMS=$(cut -d'|' -f1 "$SESSIONS_FILE" | sort -un)
LAST_SESSION=$(echo "$SESSION_NUMS" | tail -1)
NOW=$(date +%s)

for s in $SESSION_NUMS; do
  SESSION_DATA="$TMPDIR_WORK/session_${s}"
  grep "^${s}|" "$SESSIONS_FILE" > "$SESSION_DATA"

  # Process commits (need diff stats)
  COMMIT_REPOS=$(awk -F'|' -v s="$s" '$2 == "commit" {print $4}' "$SESSION_DATA" | sort -u)
  for repo_name in $COMMIT_REPOS; do
    repo_path=""
    for entry in "${REPOS[@]}"; do
      [ "${entry##*:}" = "$repo_name" ] && repo_path="${entry%%:*}" && break
    done
    [ -z "$repo_path" ] && continue

    REPO_HASHES=$(awk -F'|' -v s="$s" -v r="$repo_name" '$2=="commit" && $4==r {print $5}' "$SESSION_DATA")
    while IFS= read -r hash; do
      STATS=$(git -C "$repo_path" show --shortstat --format="" "$hash" 2>/dev/null || echo "")
      A=$(echo "$STATS" | grep -oE '[0-9]+ insertion' | grep -oE '[0-9]+' || true)
      D=$(echo "$STATS" | grep -oE '[0-9]+ deletion' | grep -oE '[0-9]+' || true)
      TS=$(awk -F'|' -v h="$hash" '$5 == h {print $2; exit}' "$SESSION_DATA")
      MSG=$(awk -F'|' -v h="$hash" '$5 == h {print $6; exit}' "$SESSION_DATA")
      echo "${s}|commit|${TS}|${repo_name}|${hash}|${MSG}|${A:-0}|${D:-0}" >> "$ENRICHED"
    done <<< "$REPO_HASHES"
  done

  # Process notes (no stats needed)
  awk -F'|' '$2 == "note" {print $1 "|note|" $2 "|__note__|" $5 "|" $6 "|0|0"}' "$SESSION_DATA" >> "$ENRICHED"

  # Process PR events (no stats needed)
  awk -F'|' '$2 == "pr" || $2 == "pr-merge" || $2 == "comment" {print $1 "|" $3 "|" $2 "|" $4 "|" $5 "|" $6 "|0|0"}' "$SESSION_DATA" >> "$ENRICHED"
done

# Enriched format: session|type|timestamp|repo|hash|subject|added|removed

# =====================================================
# TEXT OUTPUT
# =====================================================
output_text() {
  TOTAL_SESSIONS=0
  GRAND_COMMITS=0
  GRAND_ADDED=0
  GRAND_REMOVED=0
  GRAND_MINUTES=0

  echo ""
  echo "  Session Tracker"
  echo "  ==============="
  echo ""

  # Reverse order: newest first
  REVERSED_SESSIONS=$(echo "$SESSION_NUMS" | sort -rn)

  for s in $REVERSED_SESSIONS; do
    TOTAL_SESSIONS=$((TOTAL_SESSIONS + 1))

    FIRST_TS=$(awk -F'|' -v s="$s" '$1 == s {print $3; exit}' "$ENRICHED")
    LAST_TS=$(awk -F'|' -v s="$s" '$1 == s {ts=$3} END {print ts}' "$ENRICHED")
    [ -z "$FIRST_TS" ] && continue
    DURATION_MIN=$(( (LAST_TS - FIRST_TS) / 60 ))
    [ "$DURATION_MIN" -lt 1 ] && DURATION_MIN=1
    GRAND_MINUTES=$((GRAND_MINUTES + DURATION_MIN))

    START_TIME=$(date -r "$FIRST_TS" "+%-l:%M %p")
    END_TIME=$(date -r "$LAST_TS" "+%-l:%M %p")
    SESSION_DATE=$(date -r "$FIRST_TS" "+%b %-d")

    CURRENT_MARKER=""
    if [ "$s" = "$LAST_SESSION" ] && [ $((NOW - LAST_TS)) -lt "$GAP_SECONDS" ]; then
      CURRENT_MARKER="  <- current"
    fi

    # Count unique sessions from original order for display number
    DISPLAY_NUM=$(echo "$SESSION_NUMS" | grep -n "^${s}$" | cut -d: -f1)
    echo "  Session #${DISPLAY_NUM}: ${SESSION_DATE}, ${START_TIME} - ${END_TIME} (${DURATION_MIN} min)${CURRENT_MARKER}"
    echo "  $(printf '%0.s-' {1..50})"

    # Show notes first
    NOTES=$(awk -F'|' -v s="$s" '$1==s && $2=="note" {print $6}' "$ENRICHED")
    if [ -n "$NOTES" ]; then
      while IFS= read -r note; do
        printf "  %-20s %s\n" "" "# ${note}"
      done <<< "$NOTES"
    fi

    # Show PR events
    PR_EVENTS=$(awk -F'|' -v s="$s" '$1==s && ($2=="pr" || $2=="pr-merge" || $2=="comment") {print $4 ": " $6}' "$ENRICHED")
    if [ -n "$PR_EVENTS" ]; then
      while IFS= read -r ev; do
        printf "  %-20s %s\n" "" "> ${ev}"
      done <<< "$PR_EVENTS"
    fi

    # Show commits by repo
    SESSION_REPOS=$(awk -F'|' -v s="$s" '$1==s && $2=="commit" {print $4}' "$ENRICHED" | sort -u)
    for repo_name in $SESSION_REPOS; do
      COMMIT_COUNT=$(awk -F'|' -v s="$s" -v r="$repo_name" '$1==s && $2=="commit" && $4==r' "$ENRICHED" | wc -l | tr -d ' ')
      REPO_ADDED=$(awk -F'|' -v s="$s" -v r="$repo_name" '$1==s && $2=="commit" && $4==r {sum+=$7} END {print sum+0}' "$ENRICHED")
      REPO_REMOVED=$(awk -F'|' -v s="$s" -v r="$repo_name" '$1==s && $2=="commit" && $4==r {sum+=$8} END {print sum+0}' "$ENRICHED")

      GRAND_COMMITS=$((GRAND_COMMITS + COMMIT_COUNT))
      GRAND_ADDED=$((GRAND_ADDED + REPO_ADDED))
      GRAND_REMOVED=$((GRAND_REMOVED + REPO_REMOVED))

      printf "  %-20s %2d commits   +%-5d -%d\n" "$repo_name" "$COMMIT_COUNT" "$REPO_ADDED" "$REPO_REMOVED"

      awk -F'|' -v s="$s" -v r="$repo_name" '$1==s && $2=="commit" && $4==r {print $6}' "$ENRICHED" | while IFS= read -r MSG; do
        [ ${#MSG} -gt 58 ] && MSG="${MSG:0:55}..."
        printf "    * %s\n" "$MSG"
      done
      echo ""
    done

    # If session has only notes/PR events and no commits, add spacing
    if [ -z "$SESSION_REPOS" ]; then echo ""; fi
  done

  echo "  ==============="
  TOTAL_SESSIONS_COUNT=$(echo "$SESSION_NUMS" | wc -l | tr -d ' ')
  if [ "$HOURS" -le 24 ]; then PERIOD="Today"
  elif [ "$HOURS" -le 48 ]; then PERIOD="Last 2 days"
  else PERIOD="Last ${HOURS}h"; fi
  echo "  ${PERIOD}: ${TOTAL_SESSIONS_COUNT} sessions | ${GRAND_MINUTES} min | ${GRAND_COMMITS} commits | +${GRAND_ADDED} -${GRAND_REMOVED}"
  if [ "$TOTAL_SESSIONS_COUNT" -gt 1 ]; then
    echo "  Avg per session: $((GRAND_MINUTES / TOTAL_SESSIONS_COUNT)) min | $((GRAND_COMMITS / TOTAL_SESSIONS_COUNT)) commits"
  fi
  echo ""
}

# =====================================================
# HTML OUTPUT
# =====================================================
output_html() {
  # Build JSON data
  JSON_SESSIONS="["
  TOTAL_COMMITS=0
  TOTAL_ADDED=0
  TOTAL_REMOVED=0
  TOTAL_MINUTES=0
  TOTAL_NOTES=0
  TOTAL_PR_EVENTS=0
  SESSION_COUNT=0

  for s in $SESSION_NUMS; do
    SESSION_COUNT=$((SESSION_COUNT + 1))

    FIRST_TS=$(awk -F'|' -v s="$s" '$1 == s {print $3; exit}' "$ENRICHED")
    LAST_TS=$(awk -F'|' -v s="$s" '$1 == s {ts=$3} END {print ts}' "$ENRICHED")
    [ -z "$FIRST_TS" ] && continue
    DURATION_MIN=$(( (LAST_TS - FIRST_TS) / 60 ))
    [ "$DURATION_MIN" -lt 1 ] && DURATION_MIN=1
    TOTAL_MINUTES=$((TOTAL_MINUTES + DURATION_MIN))

    START_TIME=$(date -r "$FIRST_TS" "+%-l:%M %p")
    END_TIME=$(date -r "$LAST_TS" "+%-l:%M %p")
    SESSION_DATE=$(date -r "$FIRST_TS" "+%b %-d")

    IS_CURRENT="false"
    if [ "$s" = "$LAST_SESSION" ] && [ $((NOW - LAST_TS)) -lt "$GAP_SECONDS" ]; then
      IS_CURRENT="true"
    fi

    # Notes
    JSON_NOTES="["
    while IFS= read -r note; do
      [ -z "$note" ] && continue
      JSON_NOTES+="$(json_str "$note"),"
      TOTAL_NOTES=$((TOTAL_NOTES + 1))
    done < <(awk -F'|' -v s="$s" '$1==s && $2=="note" {print $6}' "$ENRICHED")
    JSON_NOTES="${JSON_NOTES%,}]"

    # PR events
    JSON_PR="["
    while IFS= read -r ev; do
      [ -z "$ev" ] && continue
      IFS='|' read -r ev_type ev_repo ev_text <<< "$ev"
      JSON_PR+="{\"type\":$(json_str "$ev_type"),\"repo\":$(json_str "$ev_repo"),\"text\":$(json_str "$ev_text")},"
      TOTAL_PR_EVENTS=$((TOTAL_PR_EVENTS + 1))
    done < <(awk -F'|' -v s="$s" '$1==s && ($2=="pr" || $2=="pr-merge" || $2=="comment") {print $2 "|" $4 "|" $6}' "$ENRICHED")
    JSON_PR="${JSON_PR%,}]"

    # Repos (commits only)
    JSON_REPOS="["
    SESSION_REPOS=$(awk -F'|' -v s="$s" '$1==s && $2=="commit" {print $4}' "$ENRICHED" | sort -u)
    for repo_name in $SESSION_REPOS; do
      R_COMMITS=$(awk -F'|' -v s="$s" -v r="$repo_name" '$1==s && $2=="commit" && $4==r' "$ENRICHED" | wc -l | tr -d ' ')
      R_ADDED=$(awk -F'|' -v s="$s" -v r="$repo_name" '$1==s && $2=="commit" && $4==r {sum+=$7} END {print sum+0}' "$ENRICHED")
      R_REMOVED=$(awk -F'|' -v s="$s" -v r="$repo_name" '$1==s && $2=="commit" && $4==r {sum+=$8} END {print sum+0}' "$ENRICHED")
      TOTAL_COMMITS=$((TOTAL_COMMITS + R_COMMITS))
      TOTAL_ADDED=$((TOTAL_ADDED + R_ADDED))
      TOTAL_REMOVED=$((TOTAL_REMOVED + R_REMOVED))

      JSON_MSGS="["
      while IFS= read -r msg; do
        JSON_MSGS+="$(json_str "$msg"),"
      done < <(awk -F'|' -v s="$s" -v r="$repo_name" '$1==s && $2=="commit" && $4==r {print $6}' "$ENRICHED")
      JSON_MSGS="${JSON_MSGS%,}]"

      JSON_REPOS+="{\"name\":$(json_str "$repo_name"),\"commits\":${R_COMMITS},\"added\":${R_ADDED},\"removed\":${R_REMOVED},\"messages\":${JSON_MSGS}},"
    done
    JSON_REPOS="${JSON_REPOS%,}]"

    JSON_SESSIONS+="{\"number\":${SESSION_COUNT},\"date\":\"${SESSION_DATE}\",\"start\":\"${START_TIME}\",\"end\":\"${END_TIME}\",\"start_ts\":${FIRST_TS},\"end_ts\":${LAST_TS},\"duration\":${DURATION_MIN},\"current\":${IS_CURRENT},\"notes\":${JSON_NOTES},\"ghEvents\":${JSON_PR},\"repos\":${JSON_REPOS}},"
  done
  JSON_SESSIONS="${JSON_SESSIONS%,}]"

  # Date range
  FIRST_DATE=$(date -r "$(awk -F'|' 'NR==1 {print $3}' "$ENRICHED")" "+%b %-d")
  LAST_DATE=$(date -r "$(awk -F'|' '{ts=$3} END {print ts}' "$ENRICHED")" "+%b %-d, %Y")

  # Formatted totals
  TOTAL_HOURS=$((TOTAL_MINUTES / 60))
  REMAINING_MINS=$((TOTAL_MINUTES % 60))
  [ "$TOTAL_HOURS" -gt 0 ] && TIME_FMT="${TOTAL_HOURS}h ${REMAINING_MINS}m" || TIME_FMT="${REMAINING_MINS}m"
  [ "$TOTAL_ADDED" -ge 1000 ] && ADDED_FMT="$(echo "scale=1; $TOTAL_ADDED / 1000" | bc)K" || ADDED_FMT="$TOTAL_ADDED"
  [ "$TOTAL_REMOVED" -ge 1000 ] && REMOVED_FMT="$(echo "scale=1; $TOTAL_REMOVED / 1000" | bc)K" || REMOVED_FMT="$TOTAL_REMOVED"

  # === Write HTML ===
  cat > "$HTML_FILE" << 'HTMLEOF'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Session Tracker</title>
<style>
  :root {
    --bg: #060608;
    --surface: #111114;
    --surface-2: #18181c;
    --surface-hover: #1e1e24;
    --border: #222228;
    --border-subtle: #1a1a1f;
    --text: #e8e8ed;
    --text-dim: #8888a0;
    --text-muted: #555566;
    --accent: #b4a0ff;
    --second-brain: #818cf8;
    --lexica: #22d3ee;
    --command-center: #fbbf24;
    --nanny-app: #34d399;
    --claude-test: #a78bfa;
    --note-color: #e0b0ff;
    --pr-color: #f0883e;
    --added: #3fb950;
    --removed: #f85149;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', system-ui, sans-serif;
    padding: 2rem 2.5rem;
    max-width: 1000px;
    margin: 0 auto;
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }

  .header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .header h1 {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }
  .header .date-range {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.1rem 1rem;
    text-align: center;
  }
  .stat-value {
    font-size: 1.6rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }
  .stat-label {
    color: var(--text-muted);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 0.15rem;
  }

  /* Sections */
  .section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .section-title {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    font-weight: 500;
  }
  .toggle-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.65rem;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    cursor: pointer;
    letter-spacing: 0.03em;
  }
  .toggle-btn:hover { border-color: var(--text-muted); color: var(--text); }

  /* Chart */
  .chart-container { position: relative; }
  .chart-row {
    display: flex;
    align-items: center;
    margin-bottom: 4px;
    height: 20px;
  }
  .chart-row.hidden { display: none; }
  .chart-label {
    width: 2.5rem;
    font-size: 0.65rem;
    color: var(--text-muted);
    text-align: right;
    margin-right: 0.6rem;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .chart-bar-track {
    flex: 1;
    height: 16px;
    display: flex;
    border-radius: 3px;
    overflow: hidden;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .chart-bar-track:hover { opacity: 0.8; }
  .chart-bar-track.note-only {
    border: 1px dashed var(--note-color);
    opacity: 0.5;
    height: 14px;
