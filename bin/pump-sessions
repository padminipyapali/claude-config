<body>

<div class="header">
  <h1>Session Tracker</h1>
  <div class="date-range" id="date-range"></div>
</div>
<div class="stats" id="stats"></div>

<div class="section">
  <div class="section-header">
    <div class="section-title">Activity per Session</div>
    <button class="toggle-btn" id="chart-toggle" onclick="toggleChart()">Show all</button>
  </div>
  <div class="chart-container" id="chart"></div>
  <div class="legend" id="legend"></div>
</div>

<div class="section">
  <div class="section-header">
    <div class="section-title">Session Details</div>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr>
        <th></th><th>#</th><th>Date</th><th>Time</th><th>Duration</th>
        <th>Activity</th><th class="r">Commits</th><th class="r">Lines</th>
      </tr></thead>
      <tbody id="table-body"></tbody>
    </table>
  </div>
</div>

<script>
HTMLEOF

  # Inject data
  echo "const SESSIONS = ${JSON_SESSIONS};" >> "$HTML_FILE"
  echo "const TOTALS = {sessions:${SESSION_COUNT},minutes:${TOTAL_MINUTES},commits:${TOTAL_COMMITS},added:${TOTAL_ADDED},removed:${TOTAL_REMOVED},notes:${TOTAL_NOTES},prEvents:${TOTAL_PR_EVENTS},time:\"${TIME_FMT}\",addedFmt:\"${ADDED_FMT}\",removedFmt:\"${REMOVED_FMT}\"};" >> "$HTML_FILE"
  echo "const DATE_RANGE = \"${FIRST_DATE} – ${LAST_DATE}\";" >> "$HTML_FILE"

  cat >> "$HTML_FILE" << 'HTMLEOF2'

const COLORS = {
  'second-brain': '#818cf8',
  'lexica': '#22d3ee',
  'command-center': '#fbbf24',
  'nanny-app': '#34d399',
  'claude-test': '#a78bfa'
};

const fmt = n => n >= 1000 ? (n/1000).toFixed(1) + 'K' : String(n);
const esc = s => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

// Reverse: newest first
const sessions = [...SESSIONS].reverse();

// Header
document.getElementById('date-range').textContent = DATE_RANGE;

// Stats
document.getElementById('stats').innerHTML = [
  { v: TOTALS.sessions, l: 'Sessions' },
  { v: TOTALS.time, l: 'Total Time' },
  { v: TOTALS.commits, l: 'Commits' },
  { v: `+${TOTALS.addedFmt} / -${TOTALS.removedFmt}`, l: 'Lines Changed' },
].map(c => `<div class="stat-card"><div class="stat-value">${c.v}</div><div class="stat-label">${c.l}</div></div>`).join('');

// Chart (newest first, show first 10 by default)
const CHART_LIMIT = 10;
let chartExpanded = false;
const maxCommits = Math.max(...sessions.map(s => s.repos.reduce((sum, r) => sum + r.commits, 0)), 1);
const allRepos = new Set();
sessions.forEach(s => s.repos.forEach(r => allRepos.add(r.name)));

function renderChart() {
  const chartEl = document.getElementById('chart');
  chartEl.innerHTML = sessions.map((s, i) => {
    const totalCommits = s.repos.reduce((sum, r) => sum + r.commits, 0);
    const isNoteOnly = totalCommits === 0;
    const pct = isNoteOnly ? 3 : (totalCommits / maxCommits) * 100;
    const hidden = !chartExpanded && i >= CHART_LIMIT ? 'hidden' : '';
    const currentMark = s.current ? ' *' : '';

    let barContent;
    if (isNoteOnly) {
      barContent = `<div class="chart-bar-track note-only" onclick="toggleRow(${s.number})"></div>`;
    } else {
      const segments = s.repos.map(r => {
        const segPct = (r.commits / totalCommits) * pct;
        return `<div class="chart-bar-segment" style="width:${segPct}%;background:${COLORS[r.name]||'#666'}"></div>`;
      }).join('');
      barContent = `<div class="chart-bar-track" onclick="toggleRow(${s.number})">${segments}</div>`;
    }

    const metaText = isNoteOnly
      ? `<span style="color:var(--note-color);opacity:0.6">notes</span><span>${s.duration}m</span>`
      : `<span class="commits-count">${totalCommits}</span><span>${s.duration}m</span>`;

    return `<div class="chart-row ${hidden}" data-chart-row>
      <div class="chart-label">#${s.number}${currentMark}</div>
      ${barContent}
      <div class="chart-meta">${metaText}</div>
    </div>`;
  }).join('');

  const btn = document.getElementById('chart-toggle');
  if (sessions.length <= CHART_LIMIT) {
    btn.style.display = 'none';
  } else {
    btn.textContent = chartExpanded ? `Show recent ${CHART_LIMIT}` : `Show all ${sessions.length}`;
  }
}

function toggleChart() {
  chartExpanded = !chartExpanded;
  renderChart();
}
renderChart();

// Legend
document.getElementById('legend').innerHTML = [...allRepos].map(name =>
  `<div class="legend-item"><div class="legend-dot" style="background:${COLORS[name]||'#666'}"></div>${name}</div>`
).join('') + (TOTALS.notes > 0 ? `<div class="legend-item"><div class="legend-dot" style="background:var(--note-color);opacity:0.6"></div>notes</div>` : '');

// Table (newest first)
const tbody = document.getElementById('table-body');
sessions.forEach(s => {
  const totalCommits = s.repos.reduce((sum, r) => sum + r.commits, 0);
  const totalAdded = s.repos.reduce((sum, r) => sum + r.added, 0);
  const totalRemoved = s.repos.reduce((sum, r) => sum + r.removed, 0);

  const pills = [];
  if (s.notes && s.notes.length > 0) pills.push(`<span class="repo-pill note-pill">notes</span>`);
  if (s.ghEvents && s.ghEvents.length > 0) pills.push(`<span class="repo-pill pr-pill">PRs</span>`);
  s.repos.forEach(r => pills.push(
    `<span class="repo-pill" style="background:${COLORS[r.name]||'#666'}18;color:${COLORS[r.name]||'#666'}">${r.name}</span>`
  ));

  const currentBadge = s.current ? '<span class="current-badge">now</span>' : '';

  const row = document.createElement('tr');
  row.className = 'session-row';
  row.id = `row-${s.number}`;
  row.onclick = () => toggleRow(s.number);
  row.innerHTML = `
    <td><span class="expand-ind">\u203A</span></td>
    <td class="mono">${s.number}${currentBadge}</td>
    <td>${s.date}</td>
    <td style="white-space:nowrap">${s.start} – ${s.end}</td>
    <td class="mono">${s.duration}m</td>
    <td><div class="repo-pills">${pills.join('')}</div></td>
    <td class="r">${totalCommits || '–'}</td>
    <td class="r">${totalCommits ? `<span class="c-added">+${fmt(totalAdded)}</span> <span class="c-removed">-${fmt(totalRemoved)}</span>` : '–'}</td>
  `;
  tbody.appendChild(row);

  // Detail row
  const detailRow = document.createElement('tr');
  detailRow.className = 'detail-row';
  detailRow.id = `detail-${s.number}`;

  let detailHtml = '';

  if (s.notes && s.notes.length > 0) {
    detailHtml += `<div class="detail-section">
      <div class="detail-section-label">Notes</div>
      ${s.notes.map(n => `<div class="detail-note">${esc(n)}</div>`).join('')}
    </div>`;
  }

  if (s.ghEvents && s.ghEvents.length > 0) {
    detailHtml += `<div class="detail-section">
      <div class="detail-section-label">GitHub Activity</div>
      ${s.ghEvents.map(e => `<div class="detail-pr">${esc(e.text)}</div>`).join('')}
    </div>`;
  }

  if (s.repos.length > 0) {
    detailHtml += s.repos.map(r => `
      <div class="detail-repo">
        <div class="detail-repo-header">
          <span class="repo-pill" style="background:${COLORS[r.name]||'#666'}18;color:${COLORS[r.name]||'#666'}">${r.name}</span>
          <span class="detail-repo-stats">${r.commits} commits · <span class="c-added">+${fmt(r.added)}</span> <span class="c-removed">-${fmt(r.removed)}</span></span>
        </div>
        ${r.messages.map(m => `<div class="detail-msg">${esc(m)}</div>`).join('')}
      </div>
    `).join('');
  }

  detailRow.innerHTML = `<td colspan="8">${detailHtml}</td>`;
  tbody.appendChild(detailRow);
});

function toggleRow(n) {
  document.getElementById(`detail-${n}`)?.classList.toggle('open');
  document.getElementById(`row-${n}`)?.classList.toggle('expanded');
}
</script>
</body>
</html>
HTMLEOF2

  echo "Report saved to: ${HTML_FILE}"
}

# === Main ===
case "$OUTPUT_FORMAT" in
  text) output_text ;;
  html) output_html ;;
esac
